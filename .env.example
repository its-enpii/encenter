# n8n
# Generate N8N_ENCRYPTION_KEY once and never change it. Losing this key means
# stored n8n credentials become unreadable.
#   openssl rand -hex 32
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=http://localhost:5678/

# Evolution API
# Long random string used as the master API key for Evolution.
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# phpMyAdmin
# Required for cookie auth. MUST be exactly 32 characters.
#   openssl rand -base64 24 | head -c 32
PMA_BLOWFISH_SECRET=

# Next.js
NODE_ENV=development
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PMA_URL=http://localhost:8081
