#!/usr/bin/env sh
# Pre-commit hook: route staged files through lint-staged (frontend ESLint +
# backend Pint). Skips when no Node tooling is available so contributors
# without `pnpm install` can still commit.

if ! command -v pnpm >/dev/null 2>&1; then
  echo "[husky] pnpm not found, skipping pre-commit lint-staged"
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "[husky] node_modules missing, skipping pre-commit lint-staged"
  echo "[husky] run \`pnpm install\` at the repo root to enable hooks"
  exit 0
fi

pnpm exec lint-staged
